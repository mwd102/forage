# Forage environment example
# Copy to .env and adjust. Secrets NEVER go into config.yaml.
#
# Comma-separated API keys, used only when auth.enabled: true in config.yaml.
# Example: FORAGE_API_KEYS=key1,key2
FORAGE_API_KEYS=

# Optional outbound proxy. Credentials are used only when proxy.enabled is
# true in config.yaml.
FORAGE_PROXY_SERVER=
FORAGE_PROXY_USERNAME=
FORAGE_PROXY_PASSWORD=

# Container timezone
TZ=UTC
